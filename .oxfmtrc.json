{
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.js", "*.html"],
      "options": { "tabWidth": 4 }
    },
    {
      "files": ["*.css"],
      "options": { "tabWidth": 2 }
    }
  ],
  "ignorePatterns": ["public/pages/Xcratch/**", "dist/**", ".min.js"]
}
