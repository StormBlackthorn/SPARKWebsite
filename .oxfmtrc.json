{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "tabWidth": 2,
  "svelte": true,
  "overrides": [
    {
      "files": ["*.js", "*.html", "*.svelte"],
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": ["*.css"],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "ignorePatterns": [
    "pages/Xcratch/**",
    "static/pages/Xcratch/**",
    "static/Xcratch/**",
    "**/Xcratch/**",
    "build/**",
    ".svelte-kit/**",
    "node_modules/**",
    "package-lock.json",
    "**/*.min.js"
  ]
}
